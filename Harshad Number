class Solution {
    public int sumOfTheDigitsOfHarshadNumber(int x) {
        int temp = x;
        int rev =0;
        int sum = 0;
        while(temp>0){
            rev = temp%10;
            temp/=10;
            sum = sum + rev;
        }         
        if(x%sum==0){
            return sum;
        }else{
            return -1;

        }
    }
}
